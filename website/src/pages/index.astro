---
import BaseLayout from "../layouts/BaseLayout.astro";

const navItems = [
  { label: "Controls", href: "#controls", modifier: "appear--scale", delay: "0.16s" },
  { label: "Architecture", href: "#architecture", modifier: "appear--soft", delay: "0.28s" },
  { label: "Evidence", href: "#evidence", modifier: "appear--scale", delay: "0.40s" },
  { label: "Start Free", href: "#start", modifier: "appear--soft", delay: "0.52s" },
] as const;

const controls = [
  { number: "01", title: "Identity & least privilege", body: "Authenticate known agents, then enforce exact allow and deny permissions with least-privilege defaults." },
  { number: "02", title: "Deterministic risk & policy", body: "Score every request from tool metadata and workflow context, then apply priority-ordered, fail-closed policy." },
  { number: "03", title: "Governed approvals", body: "Route sensitive actions through role-bound approvals with escalation, timeouts, fallback reviewers, and controlled break-glass." },
  { number: "04", title: "Exact approval binding", body: "Bind approval to the reviewed tool, destination, arguments, environment, and security context—and allow one execution only." },
  { number: "05", title: "Session-aware protection", body: "Track sensitive-data access across an agent session and block unsafe external sends before downstream execution." },
  { number: "06", title: "Simulation & audit", body: "Dry-run proposed policy behavior with zero downstream actions and retain structured, redacted decision evidence." },
] as const;

const metrics = [
  { value: "12/12", label: "evaluation scenarios correct" },
  { value: "0", label: "unauthorized downstream executions" },
  { value: "0", label: "replay successes" },
  { value: "0", label: "approval-bypass successes" },
  { value: "0", label: "context-tampering successes" },
  { value: "1/1", label: "binding mutations detected" },
  { value: "0", label: "simulation downstream executions" },
  { value: "1/1", label: "policy conflicts failed closed" },
  { value: "0.0067 ms", label: "mean deterministic evaluation latency" },
  { value: "0.0072 ms", label: "P95 deterministic evaluation latency" },
] as const;

const resources = [
  { label: "GitHub repository", href: "https://github.com/Grevanur/gatekeeper-mcp" },
  { label: "V2 evaluation report", href: "https://github.com/Grevanur/gatekeeper-mcp/blob/main/reports/v2-evaluation.md" },
  { label: "Security invariants", href: "https://github.com/Grevanur/gatekeeper-mcp/blob/main/docs/security-invariants.md" },
  { label: "V2 release notes", href: "https://github.com/Grevanur/gatekeeper-mcp/blob/main/docs/v2-release-notes.md" },
] as const;
---

<BaseLayout title="Gatekeeper — Zero-Trust Security for AI Agents">
  <div class="grain" aria-hidden="true"></div>

  <div class="hero-photo" aria-hidden="true">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      tabindex="-1"
    >
      <source
        src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260818_072341_50851634-bbc3-4c33-9acc-7647d4db44aa.mp4"
        type="video/mp4"
      />
    </video>
  </div>

  <div class="page">
    <div class="menu-backdrop" aria-hidden="true"></div>

    <header class="header">
      <a class="logo appear appear--scale" href="#top" aria-label="Gatekeeper" style="--d: 0.08s">
        <svg class="logo-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <g transform="rotate(-30 12 12)">
            <circle cx="7.3" cy="3.2" r="1.45"></circle>
            <rect x="5.5" y="4.7" width="3.6" height="14.6" rx="1.8"></rect>
            <rect x="14.9" y="4.7" width="3.6" height="14.6" rx="1.8"></rect>
            <circle cx="16.7" cy="20.8" r="1.45"></circle>
          </g>
        </svg>
        <span>Gatekeeper</span>
      </a>

      <nav id="site-nav" aria-label="Primary">
        {
          navItems.map((item) => (
            <a
              class={`nav-link appear ${item.modifier}`}
              href={item.href}
              style={`--d: ${item.delay}`}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a
        class="btn btn-solid header-cta appear appear--scale"
        href="https://github.com/Grevanur/gatekeeper-mcp"
        target="_blank"
        rel="noreferrer"
        style="--d: 0.34s"
      >
        View Source
      </a>

      <button
        class="menu-toggle appear appear--scale"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Open menu"
        style="--d: 0.34s"
      >
        <span></span><span></span><span></span>
      </button>
    </header>

    <main class="hero" id="top">
      <div class="hero-copy">
        <div class="badge appear appear--pop" style="--d: 0.22s">
          <svg class="badge-star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.6C12.55 2.6 12.88 3.15 13.08 4.7c.62 4.7 1.52 5.6 6.22 6.22 1.55.2 2.1.53 2.1 1.08s-.55.88-2.1 1.08c-4.7.62-5.6 1.52-6.22 6.22-.2 1.55-.53 2.1-1.08 2.1s-.88-.55-1.08-2.1c-.62-4.7-1.52-5.6-6.22-6.22C3.15 12.88 2.6 12.55 2.6 12s.55-.88 2.1-1.08c4.7-.62 5.6-1.52 6.22-6.22C11.12 3.15 11.45 2.6 12 2.6Z"></path>
          </svg>
          <span>Zero-Trust MCP Gateway</span>
        </div>

        <h1>
          <span class="headline-line"><span class="appear appear--mask" style="--d: 0.42s">Put <em>AI agents</em> behind</span></span>
          <span class="headline-line"><span class="appear appear--mask" style="--d: 0.62s">policy before execution.</span></span>
        </h1>

        <p class="lede appear appear--soft" style="--d: 0.82s">
          Enforce identity, least privilege, deterministic risk, policy, and governed approvals before MCP tool calls reach downstream systems.
        </p>

        <div class="hero-actions">
          <a
            class="btn btn-solid hero-btn appear appear--btn"
            href="#start"
            style="--d: 0.96s"
          >
            Start Using Gatekeeper
          </a>
          <a
            class="btn btn-ghost hero-btn appear appear--side"
            href="https://github.com/Grevanur/gatekeeper-mcp/blob/main/reports/v2-evaluation.md"
            target="_blank"
            rel="noreferrer"
            style="--d: 1.10s"
          >
            Review V2 Evidence
          </a>
        </div>
      </div>
    </main>

    <footer class="stats" aria-label="Gatekeeper V2 evaluation statistics">
      <div class="stat appear appear--stat" style="--d: 1.12s">
        <svg class="stat-icon" viewBox="0 0 24 24" aria-hidden="true">
          <defs>
            <linearGradient id="workflow-left" x1="3" y1="2" x2="14" y2="22" gradientUnits="userSpaceOnUse">
              <stop stop-color="#fff" stop-opacity=".38"></stop><stop offset=".62" stop-color="#3a3a3a"></stop>
            </linearGradient>
            <linearGradient id="workflow-right" x1="3" y1="2" x2="14" y2="22" gradientUnits="userSpaceOnUse">
              <stop stop-color="#3a3a3a"></stop><stop offset=".62" stop-color="#fff" stop-opacity=".38"></stop>
            </linearGradient>
          </defs>
          <rect x="3.4" y="2.6" width="7.2" height="18.8" rx="3.6" fill="url(#workflow-left)"></rect>
          <rect x="13.4" y="2.6" width="7.2" height="18.8" rx="3.6" fill="url(#workflow-right)"></rect>
          <rect x="9.2" y="10.9" width="5.6" height="2.2" rx="1.1" fill="#4a4a4a"></rect>
        </svg>
        <span>12/12 V2 scenarios correct</span>
      </div>

      <div class="stat appear appear--stat" style="--d: 1.28s">
        <svg class="stat-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="2.4" y="2.4" width="19.2" height="19.2" rx="6.2" fill="#fff"></rect>
          <path d="M12 7.1v7.4M8.15 12.35 12 16.2l3.85-3.85" fill="none" stroke="#111" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span>0 unauthorized downstream executions</span>
      </div>

      <div class="stat appear appear--stat" style="--d: 1.44s">
        <svg class="stat-icon-wide" viewBox="0 0 40 22" aria-hidden="true">
          <circle cx="10.2" cy="11" r="9.2" fill="#2b2b2b"></circle>
          <path d="m6.9 9.2-1.5-2.8 3.1 1.2m5 1.6 1.5-2.8-3.1 1.2" fill="#f4f4f4"></path>
          <ellipse cx="10.2" cy="12.1" rx="4.15" ry="3.7" fill="#f4f4f4"></ellipse>
          <circle cx="8.8" cy="11.7" r=".7" fill="#1a1a1a"></circle><circle cx="11.7" cy="11.7" r=".7" fill="#1a1a1a"></circle>
          <circle cx="20.2" cy="11" r="9.2" fill="#fff"></circle>
          <circle cx="17.7" cy="10" r="1.7" fill="#111"></circle><circle cx="22.7" cy="10" r="1.7" fill="#111"></circle>
          <ellipse cx="20.2" cy="12.6" rx="1.1" ry=".8" fill="#111"></ellipse>
          <path d="M17.8 14.3c1.2 1.3 3.6 1.3 4.8 0" fill="none" stroke="#111" stroke-width="1.2" stroke-linecap="round"></path>
          <circle cx="30.2" cy="11" r="9.2" fill="#f26b1d"></circle>
          <text x="30.2" y="15.1" fill="#fff" font-family="Inter, sans-serif" font-size="12.5" font-weight="700" text-anchor="middle">e</text>
        </svg>
        <span>0 replay or approval-bypass successes</span>
      </div>
    </footer>
  </div>

  <div class="site-content">
    <section class="section section-controls" id="controls" aria-labelledby="controls-title">
      <div class="section-heading reveal">
        <p class="eyebrow">Enforcement stack</p>
        <h2 id="controls-title">Every tool call earns the right to execute.</h2>
        <p>Gatekeeper sits between AI agents and MCP servers, evaluates the full security context, and forwards only allowed actions.</p>
      </div>
      <div class="control-grid">
        {controls.map((control) => (
          <article class="control-card reveal">
            <span class="card-number">{control.number}</span>
            <h3>{control.title}</h3>
            <p>{control.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section architecture-section" id="architecture" aria-labelledby="architecture-title">
      <div class="architecture-copy reveal">
        <p class="eyebrow">Request path</p>
        <h2 id="architecture-title">One control plane. A deterministic decision.</h2>
        <p>Gatekeeper authenticates the agent, checks permissions and session state, scores risk, evaluates policy, and invokes approval workflows when required.</p>
        <a class="text-link" href="https://github.com/Grevanur/gatekeeper-mcp#architecture" target="_blank" rel="noreferrer">
          Read the architecture on GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="architecture-flow reveal" aria-label="Gatekeeper request flow">
        <div class="flow-node flow-source"><span>01</span><strong>AI agent</strong><small>MCP tool request</small></div>
        <div class="flow-line" aria-hidden="true"></div>
        <div class="flow-node flow-gateway">
          <span>02</span><strong>Gatekeeper</strong>
          <small>Identity → permission → context → risk → policy → approval</small>
          <div class="decision-row"><b>ALLOW</b><b>DENY</b><b>APPROVE</b></div>
        </div>
        <div class="flow-line" aria-hidden="true"></div>
        <div class="flow-node flow-target"><span>03</span><strong>Downstream MCP</strong><small>Allowed calls only</small></div>
      </div>
    </section>

    <section class="section evidence-section" id="evidence" aria-labelledby="evidence-title">
      <div class="section-heading reveal">
        <p class="eyebrow">V2 evaluation</p>
        <h2 id="evidence-title">Evidence, not security theater.</h2>
        <p>Results from the repository’s generated deterministic evaluation report. Blocked paths recorded zero downstream execution.</p>
      </div>
      <div class="metrics-grid">
        {metrics.map((metric) => (
          <div class="metric reveal"><strong>{metric.value}</strong><span>{metric.label}</span></div>
        ))}
      </div>
      <p class="evidence-note reveal">
        Latency measures the local in-process deterministic evaluator only; it excludes network and downstream tool latency.
        <a href="https://github.com/Grevanur/gatekeeper-mcp/blob/main/reports/v2-evaluation.md" target="_blank" rel="noreferrer">Inspect the full report ↗</a>
      </p>
    </section>

    <section class="section start-section" id="start" aria-labelledby="start-title">
      <div class="pricing-card reveal">
        <p class="eyebrow">Pricing</p>
        <div class="price"><strong>$0</strong><span>Free</span></div>
        <h2>Clone it. Run it. Evaluate it.</h2>
        <p>Gatekeeper is available free from the public GitHub repository, including the gateway, safe demo MCP servers, policy configuration, tests, and the V2 evaluation harness.</p>
        <a class="btn btn-solid pricing-cta" href="https://github.com/Grevanur/gatekeeper-mcp" target="_blank" rel="noreferrer">View on GitHub</a>
      </div>

      <div class="quickstart reveal">
        <p class="eyebrow">Quick start</p>
        <h2 id="start-title">Run Gatekeeper locally.</h2>
        <ol class="steps">
          <li><span>1</span><code>git clone https://github.com/Grevanur/gatekeeper-mcp.git</code></li>
          <li><span>2</span><code>cd gatekeeper-mcp</code></li>
          <li><span>3</span><code>python3 -m venv .venv &amp;&amp; source .venv/bin/activate</code></li>
          <li><span>4</span><code>python -m pip install -e '.[dev]' &amp;&amp; cp .env.example .env</code></li>
          <li><span>5</span><code>uvicorn app.main:app --reload</code></li>
        </ol>
        <p class="quickstart-note">Then open <code>http://127.0.0.1:8000/docs</code> for the local API documentation.</p>
      </div>
    </section>

    <section class="section limitations-section" aria-labelledby="limits-title">
      <div class="limitations-copy reveal">
        <p class="eyebrow">Scope, stated plainly</p>
        <h2 id="limits-title">What V2 does not claim.</h2>
      </div>
      <p class="reveal">The current deterministic evaluation does not prove resistance to prompt injection, malicious downstream-server internals, covert channels, compromised hosts or approver accounts, enterprise identity federation, or distributed consistency failures.</p>
    </section>

    <footer class="site-footer">
      <a class="footer-brand" href="#top" aria-label="Back to top">Gatekeeper</a>
      <nav aria-label="Project resources">
        {resources.map((resource) => <a href={resource.href} target="_blank" rel="noreferrer">{resource.label}</a>)}
      </nav>
      <p>Zero-trust security gateway for MCP-connected AI agents.</p>
    </footer>
  </div>

  <script>
    (() => {
      const animated = Array.from(document.querySelectorAll<HTMLElement>(".appear"));
      const heroPhoto = document.querySelector<HTMLElement>(".hero-photo");
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#site-nav");

      animated.forEach((element) => {
        element.addEventListener("animationend", () => element.classList.add("is-in"), { once: true });
      });

      const closeMenu = () => {
        document.body.classList.remove("menu-open");
        toggle?.setAttribute("aria-expanded", "false");
        toggle?.setAttribute("aria-label", "Open menu");
      };

      toggle?.addEventListener("click", () => {
        const opening = !document.body.classList.contains("menu-open");
        document.body.classList.toggle("menu-open", opening);
        toggle.setAttribute("aria-expanded", String(opening));
        toggle.setAttribute("aria-label", opening ? "Close menu" : "Open menu");
      });

      nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenu();
      });

      const desktop = window.matchMedia("(min-width: 901px)");
      desktop.addEventListener("change", (event) => {
        if (event.matches) closeMenu();
      });

      const reveals = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
      if ("IntersectionObserver" in window) {
        document.documentElement.classList.add("reveal-ready");
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            (entry.target as HTMLElement).classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        }, { rootMargin: "0px 0px -10%", threshold: 0.08 });
        reveals.forEach((element) => observer.observe(element));
      }

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          [...animated, ...(heroPhoto ? [heroPhoto] : [])].forEach((element) => {
            const states = element.getAnimations().map((animation) => animation.playState);
            if (!states.some((state) => state === "running" || state === "finished")) {
              element.classList.add("is-in");
            }
          });
        });
      });
    })();
  </script>
</BaseLayout>
